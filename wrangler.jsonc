// Cloudflare Workers config: serves the Vite build in dist/ as static assets.
// `name` must match the Worker's name in the Cloudflare dashboard.
{
  "name": "hpe",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
